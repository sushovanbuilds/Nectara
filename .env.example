# Demo mode: whole app runs from in-memory sample data, no database, no internet.
NECTARA_DEMO=true
# Required in production; must be different from each other. Generate: openssl rand -hex 32
AUTH_SECRET=
QR_SECRET=
DATABASE_URL=postgresql://nectara:nectara@localhost:5432/nectara

# Optional AI (Ask Nectara, plain-language summaries). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Set one or both. Gemini answers first and also powers semantic search; Groq is the fallback (AI_PROVIDER=groq to flip).
# Without a key the assistant still returns matching records, found by keywords.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_MODEL=openai/gpt-oss-120b
# AI_PROVIDER=gemini
